// Created by Danil Timulib
// Gaussian Blur by existical https://www.shadertoy.com/view/Xltfzj

//!HOOK MAIN
//!BIND HOOKED
//!DESC Bloom

#define Strength 1.0

vec4 hook()
{	
	vec3 color = HOOKED_tex(HOOKED_pos).rgb;
	
	float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
	
	float Pi = 6.28318530718;
	
	// GAUSSIAN BLUR SETTINGS {{{
	float Directions = 10.0; // BLUR DIRECTIONS (Default 16.0 - More is better but slower)
	float Quality = 2.0; // BLUR QUALITY (Default 3.0 - More is better but slower)
	float Size = 8.0; // BLUR SIZE (Radius)
	// GAUSSIAN BLUR SETTINGS }}}
	
	vec2 Radius = vec2(Size/HOOKED_size);
	
	vec3 blur = color;
	
	for( float d=0.0; d<Pi; d+=Pi/Directions)
	{
		for(float i=1.0/Quality; i<1.001; i+=1.0/Quality)
		{
			blur += HOOKED_tex(HOOKED_pos+vec2(cos(d),sin(d))*Radius*vec2(i)).rgb;		
		}
	}
	
	blur /= vec3(Quality * Directions + 1.0);
	
	float max_color = max(color.r, max(color.g, color.b));
	vec3 bloom = 1.0 - (1.0 - vec3(max_color)) * (1.0 - blur);
	bloom /= max(vec3(max_color), 0.001);
	bloom *= color;
	return vec4(mix(color, bloom, Strength * max(luma, 0.5)), 1.0);
}