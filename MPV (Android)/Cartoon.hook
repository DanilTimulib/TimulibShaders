//!HOOK MAIN
//!BIND HOOKED
//!DESC Cartoon

#define Power 1.0
#define Opacity 0.76

vec4 hook()
{
	vec3 color = HOOKED_tex(HOOKED_pos).rgb;
	float max_color = max(color.r, max(color.g, color.b));
	vec3 coefLuma = vec3(0.2126, 0.7152, 0.0722);
	float luma = dot(color, coefLuma);
	luma = abs(luma * 2.0 - 1.0);
	luma = mix(0.66, 0.62, luma);

	float diff1 = dot(coefLuma, HOOKED_tex(HOOKED_pos + HOOKED_pt).rgb);
	diff1 = dot(vec4(coefLuma, -1.0), vec4(HOOKED_tex(HOOKED_pos - HOOKED_pt).rgb , diff1));
	float diff2 = dot(coefLuma, HOOKED_tex(HOOKED_pos + HOOKED_pt * vec2(1, -1)).rgb);
	diff2 = dot(vec4(coefLuma, -1.0), vec4(HOOKED_tex(HOOKED_pos + HOOKED_pt * vec2(-1, 1)).rgb , diff2));

	float edge = dot(vec2(diff1, diff2), vec2(diff1, diff2));
	float scale = sqrt((HOOKED_size.x * HOOKED_size.y) / 2073600.0);

	float newCol = clamp(pow(max(edge, 0.0), luma) * -Power * 10.2 * scale + max_color, 0.0, 1.0);
	newCol /= max(max_color, 0.001);
	return vec4(mix(color, color * vec3(newCol), Opacity), 1.0);
}